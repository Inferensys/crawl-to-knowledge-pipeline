{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inferensys.github.io/crawl-to-knowledge-pipeline/source-manifest.schema.json",
  "title": "SourceManifest",
  "type": "object",
  "required": [
    "manifest_id",
    "revision",
    "sources"
  ],
  "properties": {
    "manifest_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._:-]{4,128}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "seed_url",
          "allowed_prefixes",
          "extractor",
          "priority_tier"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "seed_url": {
            "type": "string",
            "format": "uri"
          },
          "allowed_prefixes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "extractor": {
            "type": "string",
            "enum": [
              "html_main",
              "markdown_native",
              "api_json"
            ]
          },
          "priority_tier": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "rate_limit_rps": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 20
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
